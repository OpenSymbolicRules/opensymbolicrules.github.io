# Allow-list: ignore everything, then allow the tracked paths.
*

!.gitignore
!.github/
!.github/**

!AGENTS.md
!CHANGELOG.md
!LICENSE.md
!README.md
!SECURITY.md
!justfile
!hugo.toml
!hugo-version
!dart-sass-version

!archetypes/
!archetypes/**
!assets/
!assets/**
!content/
!content/**
!layouts/
!layouts/**
!static/
!static/**
!themes/
!themes/**


!scripts/
!scripts/*.sh
!scripts/*.jl
!scripts/*.sha256

!sitegen/
!sitegen/Project.toml
!sitegen/repos.toml
!sitegen/src/
!sitegen/src/*.jl
!sitegen/test/
!sitegen/test/*.jl
